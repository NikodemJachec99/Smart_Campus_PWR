rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function rolesList() {
      return hasUserDoc() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        : [];
    }

    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token[role] == true
        || (role == 'tutor' && request.auth.token.lecturer == true)
        || rolesList().hasAny([role])
        || (role == 'tutor' && rolesList().hasAny(['lecturer']))
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isTutor() {
      return hasRole('tutor');
    }

    function isCourseMember(courseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId)/members/$(request.auth.uid));
    }

    function isCourseOwner(courseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.tutorUid == request.auth.uid;
    }

    function isCourseParticipant(courseId) {
      return isCourseMember(courseId) || isCourseOwner(courseId);
    }

    function allowedChatMimeTypes() {
      return ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/heic', 'image/heif'];
    }

    function allowedReactionKeys() {
      return ['like', 'thanks', 'plus1'];
    }

    function hasValidChatAttachment(data) {
      return !data.keys().hasAny(['attachment'])
        || (
          data.attachment is map
          && data.attachment.fileName is string
          && data.attachment.fileName.size() > 0
          && data.attachment.fileName.size() <= 180
          && data.attachment.mimeType in allowedChatMimeTypes()
          && data.attachment.sizeBytes is int
          && data.attachment.sizeBytes > 0
          && data.attachment.sizeBytes < 10 * 1024 * 1024
          && data.attachment.storagePath is string
          && data.attachment.downloadUrl is string
          && data.attachment.keys().hasOnly([
            'fileName',
            'mimeType',
            'sizeBytes',
            'storagePath',
            'downloadUrl',
            'width',
            'height'
          ])
        );
    }

    function hasValidReplyPreview(data) {
      return !data.keys().hasAny(['replyTo'])
        || (
          data.replyTo is map
          && data.replyTo.messageId is string
          && data.replyTo.senderName is string
          && data.replyTo.textPreview is string
          && data.replyTo.textPreview.size() <= 160
          && data.replyTo.attachmentName is string
          && data.replyTo.attachmentName.size() <= 180
          && data.replyTo.keys().hasOnly([
            'messageId',
            'senderName',
            'textPreview',
            'attachmentName'
          ])
        );
    }

    function isValidChatMessageCreate(announcementAllowed) {
      return request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (request.resource.data.text.size() > 0 || request.resource.data.keys().hasAny(['attachment']))
        && (!request.resource.data.keys().hasAny(['messageType'])
          || request.resource.data.messageType in ['text', 'image', 'file'])
        && (
          !request.resource.data.keys().hasAny(['attachment'])
          || request.resource.data.messageType in ['image', 'file']
        )
        && request.resource.data.clientMessageId is string
        && request.resource.data.clientMessageId.size() > 0
        && request.resource.data.isAnnouncement is bool
        && (request.resource.data.isAnnouncement == false || announcementAllowed)
        && hasValidChatAttachment(request.resource.data)
        && hasValidReplyPreview(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'senderUid',
          'senderName',
          'text',
          'isAnnouncement',
          'clientMessageId',
          'messageType',
          'attachment',
          'replyTo',
          'sentAt'
        ]);
    }

    function isOwnSoftDelete() {
      return isSignedIn()
        && resource.data.senderUid == request.auth.uid
        && request.resource.data.text == ''
        && request.resource.data.messageType == 'text'
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text',
          'messageType',
          'attachment',
          'deletedAt',
          'deletedBy'
        ]);
    }

    function isReactionSummaryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'reactionBy',
        'reactionCounts'
      ]);
    }

    function isValidReactionWrite(uid) {
      return isSignedIn()
        && uid == request.auth.uid
        && request.resource.data.reactionKey in allowedReactionKeys()
        && request.resource.data.keys().hasOnly(['reactionKey', 'createdAt']);
    }

    function availabilityPath(slotId) {
      return /databases/$(database)/documents/tutor_availability/$(slotId);
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function isBookingParticipant(booking) {
      return isSignedIn() && (
        booking.studentId == request.auth.uid
        || booking.tutorId == request.auth.uid
      );
    }

    function hasFutureWindow(data) {
      return data.startAt is timestamp
        && data.endAt is timestamp
        && data.startAt > request.time
        && data.endAt > data.startAt;
    }

    function isAvailabilityCreate() {
      return request.resource.data.tutorId is string
        && request.resource.data.tutorDisplayName is string
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.date is string
        && request.resource.data.startHour is string
        && request.resource.data.endHour is string
        && request.resource.data.isBooked == false
        && hasFutureWindow(request.resource.data)
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'open')
        && (!request.resource.data.keys().hasAny(['format']) || request.resource.data.format in ['ONLINE', 'IN_PERSON'])
        && request.resource.data.keys().hasOnly([
          'tutorId',
          'tutorDisplayName',
          'subject',
          'date',
          'startHour',
          'endHour',
          'startAt',
          'endAt',
          'isBooked',
          'createdAt',
          'durationMinutes',
          'format',
          'location',
          'meetingUrl',
          'topic',
          'status'
        ]);
    }

    function isSlotStatusTransition() {
      // Only status field (and optional updatedAt) changes
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          // Tutor: pending -> booked / pending -> open / booked -> open
          (resource.data.tutorId == request.auth.uid && (
            (resource.data.status == 'pending' && request.resource.data.status in ['booked', 'open'])
            || (resource.data.status == 'booked' && request.resource.data.status == 'open')
          ))
          // Student: open -> pending (request)
          || (isStudent() && resource.data.tutorId != request.auth.uid
              && resource.data.status == 'open' && request.resource.data.status == 'pending')
          // Admin: any transition
          || isAdmin()
        );
    }

    function isAvailabilityScheduleEdit() {
      return request.resource.data.tutorId == resource.data.tutorId
        && request.resource.data.tutorDisplayName == resource.data.tutorDisplayName
        && request.resource.data.isBooked == resource.data.isBooked
        && resource.data.isBooked == false
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.date is string
        && request.resource.data.startHour is string
        && request.resource.data.endHour is string
        && hasFutureWindow(request.resource.data)
        && (!request.resource.data.keys().hasAny(['format']) || request.resource.data.format in ['ONLINE', 'IN_PERSON'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'subject',
          'date',
          'startHour',
          'endHour',
          'startAt',
          'endAt',
          'updatedAt',
          'durationMinutes',
          'format',
          'location',
          'meetingUrl',
          'topic'
        ]);
    }

    function isBookingAvailabilitySlot(slotId) {
      return isStudent()
        && resource.data.isBooked == false
        && request.resource.data.isBooked == true
        && request.resource.data.bookingId is string
        && request.resource.data.bookedBy == request.auth.uid
        && request.resource.data.tutorId == resource.data.tutorId
        && request.resource.data.tutorDisplayName == resource.data.tutorDisplayName
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.date == resource.data.date
        && request.resource.data.startHour == resource.data.startHour
        && request.resource.data.endHour == resource.data.endHour
        && request.resource.data.tutorId != request.auth.uid
        && hasFutureWindow(request.resource.data)
        && (!resource.data.keys().hasAny(['startAt']) || request.resource.data.startAt == resource.data.startAt)
        && (!resource.data.keys().hasAny(['endAt']) || request.resource.data.endAt == resource.data.endAt)
        && getAfter(bookingPath(request.resource.data.bookingId)).data.availabilityId == slotId
        && getAfter(bookingPath(request.resource.data.bookingId)).data.studentId == request.auth.uid
        && getAfter(bookingPath(request.resource.data.bookingId)).data.status in ['booked', 'PENDING']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isBooked',
          'bookingId',
          'bookedBy',
          'bookedAt',
          'startAt',
          'endAt',
          'status'
        ]);
    }

    function isCancellingAvailabilitySlot() {
      return isSignedIn()
        && (
          resource.data.bookedBy == request.auth.uid
          || resource.data.tutorId == request.auth.uid
          || isAdmin()
        )
        && resource.data.isBooked == true
        && request.resource.data.isBooked == false
        && !request.resource.data.keys().hasAny(['bookingId', 'bookedBy', 'bookedAt'])
        && resource.data.bookingId is string
        && getAfter(bookingPath(resource.data.bookingId)).data.status in ['cancelled', 'CANCELLED', 'DECLINED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBooked', 'bookingId', 'bookedBy', 'bookedAt', 'status']);
    }

    function isValidStudentBookingCreate(bookingId) {
      return isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.tutorId != request.auth.uid
        && request.resource.data.status in ['booked', 'PENDING']
        && request.resource.data.availabilityId is string
        && exists(availabilityPath(request.resource.data.availabilityId))
        && get(availabilityPath(request.resource.data.availabilityId)).data.isBooked == false
        && get(availabilityPath(request.resource.data.availabilityId)).data.tutorId == request.resource.data.tutorId
        && get(availabilityPath(request.resource.data.availabilityId)).data.tutorDisplayName == request.resource.data.tutorDisplayName
        && get(availabilityPath(request.resource.data.availabilityId)).data.subject == request.resource.data.subject
        && get(availabilityPath(request.resource.data.availabilityId)).data.date == request.resource.data.date
        && get(availabilityPath(request.resource.data.availabilityId)).data.startHour == request.resource.data.startHour
        && get(availabilityPath(request.resource.data.availabilityId)).data.endHour == request.resource.data.endHour
        && getAfter(availabilityPath(request.resource.data.availabilityId)).data.isBooked == true
        && getAfter(availabilityPath(request.resource.data.availabilityId)).data.bookingId == bookingId
        && getAfter(availabilityPath(request.resource.data.availabilityId)).data.bookedBy == request.auth.uid
        && request.resource.data.lessonStartsAt is timestamp
        && request.resource.data.lessonEndsAt is timestamp
        && request.resource.data.lessonStartsAt > request.time
        && request.resource.data.lessonEndsAt > request.resource.data.lessonStartsAt
        && request.resource.data.lessonStartsAt == getAfter(availabilityPath(request.resource.data.availabilityId)).data.startAt
        && request.resource.data.lessonEndsAt == getAfter(availabilityPath(request.resource.data.availabilityId)).data.endAt
        && (!request.resource.data.keys().hasAny(['format']) || request.resource.data.format in ['ONLINE', 'IN_PERSON'])
        && request.resource.data.keys().hasOnly([
          'availabilityId',
          'tutorId',
          'tutorDisplayName',
          'studentId',
          'studentDisplayName',
          'subject',
          'date',
          'startHour',
          'endHour',
          'status',
          'lessonStartsAt',
          'lessonEndsAt',
          'createdAt',
          'format',
          'location',
          'meetingUrl',
          'notes'
        ]);
    }

    function isTutorStatusUpdate() {
      // Tutor (or admin) may move booking to CONFIRMED/DECLINED/COMPLETED/NO_SHOW
      return (resource.data.tutorId == request.auth.uid || isAdmin())
        && request.resource.data.status in ['CONFIRMED', 'DECLINED', 'COMPLETED', 'NO_SHOW']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'tutorNote'
        ]);
    }

    function isRescheduleOrCancel() {
      // A participant (student or tutor) or admin may reschedule or cancel
      return isBookingParticipant(resource.data)
        && resource.data.status in ['PENDING', 'CONFIRMED', 'booked']
        && (
          // Cancel
          (request.resource.data.status in ['CANCELLED', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancelReason', 'cancelledBy', 'cancelledAt', 'updatedAt'
            ])
          )
          ||
          // Reschedule (change time/location fields)
          (request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'availabilityId', 'date', 'startHour', 'endHour',
              'lessonStartsAt', 'lessonEndsAt', 'format', 'location', 'meetingUrl',
              'updatedAt', 'rescheduledBy', 'rescheduledAt'
            ])
          )
        );
    }

    function isCancellingBooking() {
      return isBookingParticipant(resource.data)
        && resource.data.status in ['booked', 'PENDING', 'CONFIRMED']
        && resource.data.availabilityId is string
        && request.resource.data.status in ['cancelled', 'CANCELLED']
        && request.resource.data.cancelReason is string
        && request.resource.data.cancelReason.size() > 0
        && request.resource.data.cancelReason.size() <= 500
        && request.resource.data.cancelledBy == request.auth.uid
        && getAfter(availabilityPath(resource.data.availabilityId)).data.isBooked == false
        && !getAfter(availabilityPath(resource.data.availabilityId)).data.keys().hasAny(['bookingId', 'bookedBy', 'bookedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'cancelReason',
          'cancelledBy',
          'cancelledAt',
          'updatedAt'
        ]);
    }

    function isValidReviewBody() {
      return request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && (!request.resource.data.keys().hasAny(['tags']) || request.resource.data.tags is list)
        && (!request.resource.data.keys().hasAny(['anonymous']) || request.resource.data.anonymous is bool);
    }

    function isGeneralTutorReview() {
      return (
          !request.resource.data.keys().hasAny(['reviewType'])
          || request.resource.data.reviewType == 'general'
        )
        && (
          !request.resource.data.keys().hasAny(['bookingId'])
          || request.resource.data.bookingId == ''
        );
    }

    function isLessonTutorReview(reviewId) {
      return request.resource.data.reviewType == 'lesson'
        && request.resource.data.bookingId is string
        && reviewId == 'lesson_' + request.resource.data.bookingId + '_' + request.auth.uid
        && exists(bookingPath(request.resource.data.bookingId))
        && get(bookingPath(request.resource.data.bookingId)).data.studentId == request.auth.uid
        && get(bookingPath(request.resource.data.bookingId)).data.tutorId == request.resource.data.tutorId
        && get(bookingPath(request.resource.data.bookingId)).data.status in ['booked', 'COMPLETED']
        && get(bookingPath(request.resource.data.bookingId)).data.lessonEndsAt is timestamp
        && get(bookingPath(request.resource.data.bookingId)).data.lessonEndsAt <= request.time;
    }

    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && request.resource.data.roles is list
        && !request.resource.data.roles.hasAny(['admin'])
        && request.resource.data.roles.hasAny(['student', 'tutor']);

      allow update: if isAdmin()
        || (isOwner(uid)
          // Owner may not change `verified` — that field is admin-only
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fcmTokens',
            'updatedAt',
            'bio',
            'subjects',
            'experienceYears',
            'program',
            'studyYear',
            'faculty'
          ]));
      allow delete: if false;
    }

    match /tutor_availability/{slotId} {
      allow read: if isSignedIn();

      allow create: if (isAdmin() || (isTutor() && request.resource.data.tutorId == request.auth.uid))
        && isAvailabilityCreate();

      allow update: if ((isAdmin() || (isTutor() && resource.data.tutorId == request.auth.uid))
          && isAvailabilityScheduleEdit())
        || isCancellingAvailabilitySlot()
        || isBookingAvailabilitySlot(slotId)
        || (isSignedIn() && isSlotStatusTransition());

      allow delete: if isAdmin()
        || (isTutor() && resource.data.tutorId == request.auth.uid && resource.data.isBooked == false);
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && (
          resource.data.studentId == request.auth.uid
          || resource.data.tutorId == request.auth.uid
        ));

      allow create: if isValidStudentBookingCreate(bookingId);
      allow update: if isAdmin()
        || isCancellingBooking()
        || isTutorStatusUpdate()
        || isRescheduleOrCancel();
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();

      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.tutorId != request.auth.uid
        && isValidReviewBody()
        && (isGeneralTutorReview() || isLessonTutorReview(reviewId));

      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.tutorId != request.auth.uid
        && request.resource.data.status == 'open'
        && (!request.resource.data.keys().hasAny(['severity'])
          || request.resource.data.severity in ['LOW', 'MEDIUM', 'HIGH'])
        // Prevent student from pre-writing admin-only fields
        && !request.resource.data.keys().hasAny(['moderatorNote']);

      // Admin may update status (open/in_review/resolved/dismissed) and add moderatorNote
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderatorNote', 'updatedAt', 'resolvedAt'
        ])
        && request.resource.data.status in ['open', 'in_review', 'resolved', 'dismissed'];

      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin()
        || (isTutor() && resource.data.tutorUid == request.auth.uid)
        || (resource.data.courseId is string && isCourseMember(resource.data.courseId));

      allow create: if (isAdmin()
          || (isTutor()
            && request.resource.data.tutorUid == request.auth.uid
            && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.tutorUid == request.auth.uid))
        && request.resource.data.courseId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;

      allow update: if isAdmin()
        || (isTutor() && resource.data.tutorUid == request.auth.uid);
      allow delete: if false;

      match /submissions/{submissionId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource.data.studentUid == request.auth.uid)
          || (isTutor()
              && get(/databases/$(database)/documents/assignments/$(assignmentId)).data.tutorUid == request.auth.uid);

        allow create: if isStudent()
          && request.resource.data.studentUid == request.auth.uid
          && submissionId == request.auth.uid;

        allow update: if isAdmin()
          || (isStudent()
              && resource.data.studentUid == request.auth.uid
              && request.resource.data.studentUid == request.auth.uid);

        allow delete: if isAdmin()
          || (isStudent() && resource.data.studentUid == request.auth.uid);
      }
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();

      allow create: if (isTutor() || isAdmin())
        && request.resource.data.tutorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.memberCount == 0;

      allow update: if ((isAdmin() || (isTutor() && resource.data.tutorUid == request.auth.uid))
          && request.resource.data.tutorUid == resource.data.tutorUid)
        || (isCourseParticipant(courseId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAtBy']))
        || (isCourseParticipant(courseId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['typing']));

      allow delete: if isAdmin()
        || (isTutor() && resource.data.tutorUid == request.auth.uid);

      match /members/{uid} {
        allow read: if isSignedIn() && (
          request.auth.uid == uid
          || resource.data.studentUid == request.auth.uid
          || isAdmin()
          || get(/databases/$(database)/documents/courses/$(courseId)).data.tutorUid == request.auth.uid
        );
        allow create: if isStudent()
          && uid == request.auth.uid
          && request.resource.data.studentUid == request.auth.uid;
        allow delete: if isSignedIn() && (
          request.auth.uid == uid
          || isAdmin()
          || get(/databases/$(database)/documents/courses/$(courseId)).data.tutorUid == request.auth.uid
        );
      }

      match /messages/{messageId} {
        allow read: if isCourseMember(courseId) || isCourseOwner(courseId) || isAdmin();
        allow create: if (isCourseMember(courseId) || isCourseOwner(courseId))
          && isValidChatMessageCreate(isCourseOwner(courseId) || isAdmin());
        allow update: if isAdmin()
          || ((isCourseMember(courseId) || isCourseOwner(courseId)) && (isOwnSoftDelete() || isReactionSummaryUpdate()));
        allow delete: if isAdmin();

        match /reactions/{uid} {
          allow read: if isCourseMember(courseId) || isCourseOwner(courseId) || isAdmin();
          allow create, update: if (isCourseMember(courseId) || isCourseOwner(courseId))
            && isValidReactionWrite(uid);
          allow delete: if (isCourseMember(courseId) || isCourseOwner(courseId))
            && uid == request.auth.uid;
        }
      }

      match /materials/{materialId} {
        allow read: if isCourseParticipant(courseId) || isAdmin();

        allow create: if isCourseParticipant(courseId)
          && request.resource.data.uploaderUid == request.auth.uid
          && request.resource.data.uploaderName is string
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() > 0
          && request.resource.data.fileName.size() <= 180
          && request.resource.data.mimeType in allowedChatMimeTypes()
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes < 10 * 1024 * 1024
          && request.resource.data.storagePath is string
          && request.resource.data.downloadUrl is string
          && request.resource.data.keys().hasOnly([
            'fileName',
            'mimeType',
            'sizeBytes',
            'storagePath',
            'downloadUrl',
            'uploaderUid',
            'uploaderName',
            'createdAt'
          ]);

        allow update: if isAdmin();

        allow delete: if isAdmin()
          || isCourseOwner(courseId)
          || (isCourseParticipant(courseId) && resource.data.uploaderUid == request.auth.uid);
      }
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      function isReadReceiptUpdate() {
        return isParticipant()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAtBy']);
      }
      function isTypingUpdate() {
        return isParticipant()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['typing']);
      }
      allow read: if isParticipant() || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.type == 'direct'
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAdmin()
        || isReadReceiptUpdate()
        || isTypingUpdate();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && isValidChatMessageCreate(false);
        allow update: if isAdmin()
          || (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && (isOwnSoftDelete() || isReactionSummaryUpdate()));
        allow delete: if isAdmin();

        match /reactions/{uid} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
          allow create, update: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && isValidReactionWrite(uid);
          allow delete: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && uid == request.auth.uid;
        }
      }
    }

    match /message_reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.threadKind in ['direct', 'course']
        && request.resource.data.threadId is string
        && request.resource.data.messageId is string
        && request.resource.data.messageSenderUid is string
        && request.resource.data.textPreview is string
        && request.resource.data.textPreview.size() <= 300
        && request.resource.data.attachmentName is string
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'threadKind',
          'threadId',
          'messageId',
          'messageSenderUid',
          'reporterUid',
          'textPreview',
          'attachmentName',
          'status',
          'createdAt'
        ]);
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
