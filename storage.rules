rules_version = '2';
// Cross-service rules: the Cloud Storage service agent needs the
// roles/firebaserules.firestoreServiceAgent role to read Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function assignmentPath(assignmentId) {
      return /databases/(default)/documents/assignments/$(assignmentId);
    }

    function conversationPath(conversationId) {
      return /databases/(default)/documents/conversations/$(conversationId);
    }

    function coursePath(courseId) {
      return /databases/(default)/documents/courses/$(courseId);
    }

    function courseMemberPath(courseId) {
      return /databases/(default)/documents/courses/$(courseId)/members/$(request.auth.uid);
    }

    function bookingPath(bookingId) {
      return /databases/(default)/documents/bookings/$(bookingId);
    }

    function isLessonParticipant(bookingId) {
      return isSignedIn()
        && firestore.exists(bookingPath(bookingId))
        && (
          firestore.get(bookingPath(bookingId)).data.studentId == request.auth.uid
          || firestore.get(bookingPath(bookingId)).data.tutorId == request.auth.uid
        );
    }

    function isLessonTutor(bookingId) {
      return isSignedIn()
        && firestore.exists(bookingPath(bookingId))
        && firestore.get(bookingPath(bookingId)).data.tutorId == request.auth.uid;
    }

    function rolesList() {
      return isSignedIn() && firestore.exists(userPath()) && firestore.get(userPath()).data.roles is list
        ? firestore.get(userPath()).data.roles
        : [];
    }

    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token[role] == true
        || (role == 'tutor' && request.auth.token.lecturer == true)
        || rolesList().hasAny([role])
        || (role == 'tutor' && rolesList().hasAny(['lecturer']))
      );
    }

    function canReadSubmission(assignmentId, studentUid) {
      return isSignedIn() && (
        request.auth.uid == studentUid
        || hasRole('admin')
        || (
          hasRole('tutor')
          && firestore.exists(assignmentPath(assignmentId))
          && firestore.get(assignmentPath(assignmentId)).data.tutorUid == request.auth.uid
        )
      );
    }

    function allowedChatMimeTypes() {
      return ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/heic', 'image/heif'];
    }

    function canReadDirectChat(conversationId) {
      return isSignedIn()
        && firestore.exists(conversationPath(conversationId))
        && request.auth.uid in firestore.get(conversationPath(conversationId)).data.participants;
    }

    function canReadCourseChat(courseId) {
      return isSignedIn()
        && firestore.exists(coursePath(courseId))
        && (
          firestore.get(coursePath(courseId)).data.tutorUid == request.auth.uid
          || firestore.exists(courseMemberPath(courseId))
        );
    }

    function canWriteChatAttachment(senderUid) {
      return isSignedIn()
        && request.auth.uid == senderUid
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in allowedChatMimeTypes();
    }

    match /submissions/{assignmentId}/{studentUid}/{fileName} {
      allow read: if canReadSubmission(assignmentId, studentUid);
      allow create, update: if isSignedIn()
        && request.auth.uid == studentUid
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSignedIn() && (request.auth.uid == studentUid || hasRole('admin'));
    }

    match /chat/direct/{conversationId}/{senderUid}/{clientMessageId}/{fileName} {
      allow read: if canReadDirectChat(conversationId) || hasRole('admin');
      allow create, update: if canReadDirectChat(conversationId)
        && canWriteChatAttachment(senderUid);
      allow delete: if isSignedIn() && (request.auth.uid == senderUid || hasRole('admin'));
    }

    match /chat/courses/{courseId}/{senderUid}/{clientMessageId}/{fileName} {
      allow read: if canReadCourseChat(courseId) || hasRole('admin');
      allow create, update: if canReadCourseChat(courseId)
        && canWriteChatAttachment(senderUid);
      allow delete: if isSignedIn() && (request.auth.uid == senderUid || hasRole('admin'));
    }

    match /course_materials/{courseId}/{uploaderUid}/{materialId}/{fileName} {
      allow read: if canReadCourseChat(courseId) || hasRole('admin');
      allow create, update: if canReadCourseChat(courseId)
        && canWriteChatAttachment(uploaderUid);
      allow delete: if isSignedIn() && (
        request.auth.uid == uploaderUid
        || hasRole('admin')
        || (
          firestore.exists(coursePath(courseId))
          && firestore.get(coursePath(courseId)).data.tutorUid == request.auth.uid
        )
      );
    }

    match /lesson_materials/{bookingId}/{uploaderUid}/{materialId}/{fileName} {
      allow read: if isLessonParticipant(bookingId) || hasRole('admin');
      allow create, update: if isLessonParticipant(bookingId)
        && request.auth.uid == uploaderUid
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in allowedChatMimeTypes();
      allow delete: if isSignedIn() && (
        request.auth.uid == uploaderUid
        || hasRole('admin')
        || isLessonTutor(bookingId)
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
